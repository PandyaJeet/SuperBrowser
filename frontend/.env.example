# Copy to .env.local and fill in. Vite only exposes variables prefixed with VITE_.
#
# NOTE: anything here is bundled into the client build and is therefore visible
# to anyone who loads the page. This token gates a self-hosted backend; it is
# not a user credential. Do not reuse it as one.

# REQUIRED for the web build. Must match SUPERBROWSER_SESSION_TOKEN in
# backend/.env exactly, or every search returns 401 and the UI shows an
# authorisation error.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Not needed for the Electron desktop app: it generates its own token on first
# launch and injects it over IPC, so the renderer never sees it.
VITE_SUPERBROWSER_SESSION_TOKEN=replace_with_same_token_as_backend

# Optional. Override the auto-detected backend URL.
# Auto-detection handles localhost, GitHub Codespaces, and Electron already.
# VITE_API_BASE=http://localhost:8000
# VITE_API_BASE_ELECTRON=http://127.0.0.1:8000
