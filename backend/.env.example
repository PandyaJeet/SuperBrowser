SERPAPI_API_KEY=your_serpapi_key
GROQ_API_KEY=your_groq_key
# Comma-separated frontend origins. Defaults to the Vite dev server when unset.
ALLOWED_ORIGINS=http://localhost:5173

# REQUIRED. Shared secret guarding /api/search/* and /api/context/*.
# Without it every one of those routes returns HTTP 500
# ("Server authentication not configured") — the backend fails closed.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# The web frontend MUST send the same value as VITE_SUPERBROWSER_SESSION_TOKEN
# (see frontend/.env.example). If the two do not match, every search returns 401.
# The Electron desktop app does not use this — it generates its own token and
# injects it over IPC.
SUPERBROWSER_SESSION_TOKEN=replace_with_generated_token

# Optional. Directory for per-tab browsing-context JSON files.
# Defaults to /tmp/superbrowser_contexts, which survives a Render sleep/wake
# cycle but not a redeploy. Point at a mounted volume for durable storage.
# CONTEXT_STORE_DIR=/tmp/superbrowser_contexts
